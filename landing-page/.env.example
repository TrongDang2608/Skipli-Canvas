# ==============================================================================
# SKIPLI CANVAS LANDING PAGE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# URL pointing to main Skipli Canvas App authentication page
# Local development: http://localhost:5173/auth
# Production: https://app.skipli-canvas.com/auth
VITE_APP_URL=http://localhost:5173/auth

# (Optional) YouTube Video ID for demo video modal
# Example: https://www.youtube.com/watch?v=dQw4w9WgXcQ -> VITE_DEMO_YOUTUBE_ID=dQw4w9WgXcQ
# If left empty, fallback to local /Demo_Video.mp4
VITE_DEMO_YOUTUBE_ID=
