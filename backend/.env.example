# ==============================================================================
# SKIPLI CANVAS BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
TRUST_PROXY=false

# GoClaw AI Engine Configuration
GOCLAW_URL=http://localhost:18790
GOCLAW_GATEWAY_TOKEN=your_goclaw_gateway_token_here
GOCLAW_AGENT_ID=tho-xay-web-3
GOCLAW_WORKSPACE_DIR=

# Firebase Firestore Configuration
# Option 1 (Cloud / Heroku Production): Minified 1-line JSON or Base64 string
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option 2 (Local Development): Path to local serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# JWT Dual-Token Authentication (Required on Production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 / MinIO Storage Configuration
# Set S3_ENDPOINT empty or use AWS endpoint when using official AWS S3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=skipli-canvas-storage
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_FORCE_PATH_STYLE=true

# Client & Cookie Configuration
FRONTEND_URL=http://localhost:5173
COOKIE_NAME=refreshToken
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/api/auth
COOKIE_MAX_AGE_DAYS=7

# CORS Allowed Origins (Comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_MAX_AGE=86400

# Rate Limiter Security Configuration (Time in ms)
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=15
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=900000
RATE_LIMIT_FORGOT_PASSWORD_MAX=5

# SMTP Email Relay Configuration (Brevo / SendGrid / Gmail)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=Skipli Canvas <no-reply@skipli.com>
PASSWORD_RESET_TOKEN_EXPIRES_IN=15m

# Stripe Payment Gateway Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
